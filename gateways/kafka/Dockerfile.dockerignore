# This image only. Root .dockerignore must keep .git so the server image
# can stamp vergen git metadata. This file replaces the root ignore file
# for gateways/kafka/Dockerfile.
.git
.config
.dockerignore
.github
.gitignore
.idea
.vscode
.zed
/assets
/core/certs
/helm
/licenses
/local_data
/performance_results
# Selectively exclude scripts/ subdirs not needed in container builds.
# scripts/ci/third-party-licenses.sh + render-node-licenses.mjs are
# required by the convenience-binary Dockerfiles to render LICENSE-binary
# at build time.
/scripts/dashboard
/scripts/performance
/scripts/*.sh
/scripts/ci/*
!/scripts/ci/third-party-licenses.sh
!/scripts/ci/render-node-licenses.mjs
**/target
/target
!/target/debug/iggy
!/target/debug/iggy-server
!/target/debug/iggy-mcp
!/target/debug/iggy-connectors
/web/node_modules
/web/dist
